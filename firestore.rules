rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & data
    match /users/{userId} {
      // Allow read/write for user profile
      allow read, write: if true;

      // Attempts subcollection
      match /attempts/{attemptId} {
        allow read, write: if true;
      }

      // Mistakes subcollection
      match /mistakes/{mistakeId} {
        allow read, write: if true;
      }

      // Study plans subcollection
      match /studyPlans/{planId} {
        allow read, write: if true;
      }
    }

    // Ready-made plans
    match /readyPlans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Platform models and questions bank
    match /models/{modelId} {
      allow read: if true;
      allow write: if true;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    match /challenges/{challengeId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
